{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "site",
  "buildCommand": "",
  "cleanUrls": true,
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/events/night-sky-series-september-skies(/)?",
      "destination": "/venues/bellingrath-gardens/",
      "permanent": true
    },
    {
      "source": "/events/fall-in-love-with-speech-honey-b-bloom-mommy-me-session-on-the(/)?",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/events/ribbon-cutting-advance-auto-parts(/)?",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/events/family-art(/)?",
      "destination": "/venues/mobile-museum-of-art/",
      "permanent": true
    },
    {
      "source": "/events/business-after-hours-with-cgi(/)?",
      "destination": "/venues/innovation-portal/",
      "permanent": true
    },
    {
      "source": "/events/tina-friml(/)?",
      "destination": "/venues/downtown-mobile/",
      "permanent": true
    },
    {
      "source": "/events/the-midnight-matinee-the-temple-of-boom(/)?",
      "destination": "/venues/downtown-mobile/",
      "permanent": true
    },
    {
      "source": "/events/the-great-bellingrath-harvest(/)?",
      "destination": "/venues/bellingrath-gardens/",
      "permanent": true
    },
    {
      "source": "/events/naturenauts-stem-day(/)?",
      "destination": "/venues/bellingrath-gardens/",
      "permanent": true
    },
    {
      "source": "/events/little-tikes-jump(/)?",
      "destination": "/venues/pump-it-up-mobile/",
      "permanent": true
    },
    {
      "source": "/events/kids-day-young-entrepreneur-showcase(/)?",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/events/dog-days-at-mbg(/)?",
      "destination": "/venues/mobile-botanical-gardens/",
      "permanent": true
    },
    {
      "source": "/events/donuts-bubble-bash-jump(/)?",
      "destination": "/venues/pump-it-up-mobile/",
      "permanent": true
    },
    {
      "source": "/events/art-of-the-paw(/)?",
      "destination": "/venues/eastern-shore-art-center/",
      "permanent": true
    },
    {
      "source": "/events/pop-and-jump(/)?",
      "destination": "/venues/pump-it-up-mobile/",
      "permanent": true
    },
    {
      "source": "/events/austin-meade(/)?",
      "destination": "/venues/the-merry-widow/",
      "permanent": true
    },
    {
      "source": "/events/lyfe-jennings(/)?",
      "destination": "/venues/soul-kitchen/",
      "permanent": true
    },
    {
      "source": "/events/delta-discovery-cruise(/)?",
      "destination": "/venues/five-rivers-delta-center/",
      "permanent": true
    },
    {
      "source": "/events/sunday-sunset-concert-series(/)?",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/events/morgan-wade-loves-insane-tour(/)?",
      "destination": "/venues/soul-kitchen/",
      "permanent": true
    },
    {
      "source": "/events/story-time-at-everhope-baptist-church(/)?",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/contact(/)?",
      "destination": "/about/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "(.*)\\.vercel\\.app"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains"
        }
      ]
    }
  ]
}
